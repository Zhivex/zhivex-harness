{
  "name": "@zhivex-ai/harness",
  "version": "0.1.0",
  "description": "Provider-portable coding agent harness powered by Zhivex AI SDK.",
  "type": "module",
  "private": true,
  "bin": {
    "zhivex-harness": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "bun run dist/cli.js",
    "build": "bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@zhivex-ai/agents": "1.2.0",
    "@zhivex-ai/core": "1.5.0",
    "@zhivex-ai/meta": "0.2.0",
    "@zhivex-ai/openai": "0.9.4",
    "@zhivex-ai/qwen": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.3.7"
  },
  "packageManager": "bun@1.3.7"
}
