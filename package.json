{
  "name": "@zhivex-ai/harness",
  "version": "1.0.0-rc.8",
  "description": "Governed, provider-portable runtime for coding agents with durable approvals and isolated repository execution.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhivex/zhivex-harness.git"
  },
  "bugs": {
    "url": "https://github.com/Zhivex/zhivex-harness/issues"
  },
  "homepage": "https://github.com/Zhivex/zhivex-harness#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "ai",
    "agents",
    "coding-agent",
    "agent-runtime",
    "agent-governance",
    "change-control",
    "policy-as-code",
    "software-supply-chain",
    "sandbox",
    "durable-workflows",
    "mcp",
    "docker",
    "typescript",
    "node",
    "bun",
    "harness",
    "zhivex"
  ],
  "bin": {
    "zhivex-harness": "./dist/cli.js",
    "zhx": "./dist/zhx.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "ROADMAP.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md",
    "LICENSE",
    "docs",
    "contracts",
    "evaluations",
    "examples",
    "fixtures"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "start": "node dist/cli.js",
    "build": "bun run scripts/clean-dist.ts && bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target node --packages external && cp ./dist/cli.js ./dist/zhx.js && bun build ./scripts/verify-historical-migrations.ts --outfile ./dist/verify-historical-migrations.js --target node --packages external && bun build ./scripts/hostile-repository-demo.ts --outfile ./dist/hostile-repository-demo.js --target node --packages external && tsc --emitDeclarationOnly",
    "prepack": "bun run build",
    "docs:check": "bun run scripts/check-docs.ts",
    "contract:check": "bun run scripts/check-1-0-readiness.ts",
    "contract:signatures:update": "bun run scripts/generate-stable-api-signatures.ts --write",
    "migration:check": "bun run scripts/verify-historical-migrations.ts",
    "readiness:1.0": "bun run scripts/check-1-0-readiness.ts",
    "readiness:1.0:release": "bun run scripts/check-1-0-readiness.ts --release",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "evaluate": "bun run scripts/evaluate.ts",
    "benchmark:workspace": "bun run scripts/benchmark-workspace.ts",
    "benchmark:workspace:ci": "bun run scripts/benchmark-workspace.ts --files 1000 --page-size 100 --repetitions 3 --warmups 0",
    "benchmark:oci": "bun run scripts/benchmark-oci.ts",
    "benchmark:safe-fix": "bun run scripts/benchmark-time-to-safe-fix.ts",
    "benchmark:safe-fix:ci": "bun run scripts/benchmark-time-to-safe-fix.ts --tasks 2 --repetitions 1 --profiles direct,governed,optimized --carriers rule_file --summary",
    "benchmark:safe-fix:live": "bun --env-file=.env run scripts/benchmark-time-to-safe-fix.ts --driver-zhivex",
    "benchmark:safe-fix:live:smoke": "bun --env-file=.env run scripts/benchmark-time-to-safe-fix.ts --tasks 2 --repetitions 1 --profiles direct,governed,optimized --carriers rule_file --driver-zhivex --summary",
    "benchmark:safe-fix:live:expanded": "bun --env-file=.env run scripts/benchmark-time-to-safe-fix.ts --dataset evaluations/time-to-safe-fix-expanded.jsonl --dataset-name zhivex-time-to-safe-fix-expanded --tasks 12 --repetitions 3 --profiles direct,governed,optimized --carriers rule_file --driver-zhivex --driver-timeout-ms 300000 --summary",
    "benchmark:safe-fix:baseline": "bun run scripts/create-time-to-safe-fix-baseline.ts",
    "benchmark:safe-fix:image:check": "bun run scripts/build-time-to-safe-fix-image.ts --validate-only",
    "benchmark:safe-fix:image:build": "bun run scripts/build-time-to-safe-fix-image.ts",
    "smoke:package": "bun run build && bun run scripts/package-smoke.ts",
    "smoke:artifact": "bun run scripts/package-smoke.ts",
    "smoke:mcp": "bun run scripts/mcp-interoperability-smoke.ts",
    "smoke:mcp:official": "bun run scripts/mcp-official-sdk-smoke.ts",
    "smoke:oci": "bun run scripts/oci-execution-smoke.ts",
    "smoke:live": "bun --env-file=.env run scripts/live-provider-smoke.ts",
    "smoke:live:orchestration": "bun --env-file=.env run scripts/live-orchestration-smoke.ts",
    "smoke:live:routing": "bun --env-file=.env run scripts/live-routing-smoke.ts",
    "smoke:live:execution": "bun --env-file=.env run scripts/live-execution-smoke.ts",
    "demo:hostile": "bun run dist/hostile-repository-demo.js",
    "artifact:check": "bun run scripts/check-release-artifact.ts",
    "pack:inspect": "bun run build && bun pm pack --dry-run --ignore-scripts",
    "check": "bun run docs:check && bun run contract:check && bun run typecheck && bun test && bun run migration:check && bun run evaluate && bun run benchmark:workspace:ci && bun run benchmark:safe-fix:image:check && bun run benchmark:safe-fix:ci && bun run smoke:mcp && bun run smoke:mcp:official && bun run smoke:oci && bun run smoke:package",
    "release:check": "bun run check && bun audit && bun pm untrusted && bun run pack:inspect && bun run scripts/check-release-readiness.ts",
    "release:status": "bun run scripts/check-registry-release-status.ts",
    "release:verify": "bun run scripts/verify-registry-release.ts"
  },
  "dependencies": {
    "@zhivex-ai/agents": "1.3.0",
    "@zhivex-ai/core": "1.11.0",
    "@zhivex-ai/gemini": "0.11.0",
    "@zhivex-ai/meta": "0.2.2",
    "@zhivex-ai/openai": "0.10.0",
    "@zhivex-ai/qwen": "0.11.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "@zhivex-ai/core": "1.11.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@types/bun": "1.3.14",
    "@types/node": "26",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.0"
}
