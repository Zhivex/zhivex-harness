{
  "name": "zhivex-harness-desktop",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "main": "build/main.cjs",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "package": "bun run build && bun run scripts/package.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:packaged": "bun run scripts/smoke.ts --packaged",
    "smoke:restart": "bun run scripts/smoke-restart.ts",
    "smoke:restart:packaged": "bun run scripts/smoke-restart.ts --packaged",
    "smoke:worktrees": "bun run scripts/smoke-worktrees.ts",
    "smoke:worktrees:packaged": "bun run scripts/smoke-worktrees.ts --packaged",
    "prepare:harness": "bun run scripts/prepare-harness.ts",
    "smoke:checkpoints": "bun run scripts/smoke-checkpoints.ts",
    "smoke:checkpoints:packaged": "bun run scripts/smoke-checkpoints.ts --packaged",
    "smoke:checkpoint-cli": "bun run scripts/smoke-checkpoint-cli.ts",
    "smoke:checkpoint-recovery": "bun run scripts/smoke-checkpoints.ts --interrupted-fork"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "diff": "^9.0.0",
    "lucide-react": "1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "44.4.5"
  },
  "trustedDependencies": [
    "electron"
  ],
  "harness": {
    "version": "1.4.0-rc.2"
  }
}
