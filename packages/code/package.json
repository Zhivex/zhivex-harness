{
  "name": "@zhivex-ai/code",
  "version": "0.3.0-rc.6",
  "description": "Zhivex terminal product powered by the Harness engine",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhivex/zhivex-harness.git",
    "directory": "packages/code"
  },
  "bin": {
    "zhivex-code": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples/first-use.mjs",
    "examples/offline-provider.mjs",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "bun run build && bun test tests",
    "smoke:installed": "node scripts/installed-journey.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@zhivex-ai/harness": "1.4.0-rc.6",
    "@zhivex-ai/agents": "1.11.0",
    "@zhivex-ai/core": "1.31.0",
    "zod": "4.6.5"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "next"
  }
}
