{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhivex Assistant",
  "version": "0.1.0",
  "identifier": "ai.zhivex.assistant.preview",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": [],
      "csp": "default-src 'self'; style-src 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "resources": {
      "runtime/": "runtime/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
