# Configure only the providers you plan to use.
OPENAI_API_KEY=
MODEL_API_KEY=
DASHSCOPE_API_KEY=
GEMINI_API_KEY=

# Optional endpoint/workspace overrides.
# OPENAI_BASE_URL=https://api.openai.com/v1
# META_BASE_URL=https://api.meta.ai/v1
# QWEN_BASE_URL=
# QWEN_WORKSPACE_ID=
# QWEN_REGION=singapore
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional durable scope and budgets.
# ZHIVEX_HARNESS_STORE=sqlite
# ZHIVEX_HARNESS_TENANT_ID=local
# ZHIVEX_HARNESS_NAMESPACE=
# ZHIVEX_HARNESS_MAX_TOOL_CALLS=32
# ZHIVEX_HARNESS_MAX_TOOL_ERRORS=4
# ZHIVEX_HARNESS_MAX_TOTAL_TOKENS=120000
# ZHIVEX_HARNESS_TIMEOUT_MS=900000

# Optional cost ceiling. Pricing is operator-supplied per million tokens.
# ZHIVEX_HARNESS_MAX_COST_USD=0.50
# ZHIVEX_HARNESS_INPUT_COST_PER_MILLION=2.50
# ZHIVEX_HARNESS_OUTPUT_COST_PER_MILLION=10

# Optional 0.5 capability, MCP, and subagent configuration.
# ZHIVEX_HARNESS_REQUIRED_CAPABILITIES=streaming,tools
# ZHIVEX_HARNESS_MCP_CONFIG=examples/mcp-config.json
# ZHIVEX_HARNESS_SUBAGENTS=explorer,implementer,tester,reviewer
# ZHIVEX_HARNESS_SUBAGENT_MAX_STEPS=8
# ZHIVEX_HARNESS_SUBAGENT_MAX_TOOL_CALLS=16
# ZHIVEX_HARNESS_SUBAGENT_MAX_TOOL_ERRORS=3
# ZHIVEX_HARNESS_SUBAGENT_MAX_INPUT_TOKENS=30000
# ZHIVEX_HARNESS_SUBAGENT_MAX_OUTPUT_TOKENS=8000
# ZHIVEX_HARNESS_SUBAGENT_MAX_TOTAL_TOKENS=36000
# ZHIVEX_HARNESS_SUBAGENT_TIMEOUT_MS=300000
# ZHIVEX_HARNESS_MAX_PARALLEL_REVIEWS=2

# Optional enforced local execution. The image must be preloaded.
# ZHIVEX_HARNESS_EXECUTION=oci
# ZHIVEX_HARNESS_OCI_RUNTIME=docker
# ZHIVEX_HARNESS_OCI_IMAGE=node:24-bookworm-slim
# ZHIVEX_HARNESS_OCI_ALLOWED_COMMANDS=node,npm
# ZHIVEX_HARNESS_OCI_MAX_PROCESS_RUNTIME_MS=120000
# ZHIVEX_HARNESS_OCI_MAX_PROCESS_OUTPUT_BYTES=20480
# ZHIVEX_HARNESS_OCI_MAX_MEMORY_MB=1024
# ZHIVEX_HARNESS_OCI_MAX_PIDS=128
# ZHIVEX_HARNESS_OCI_MAX_CPUS=2
# ZHIVEX_HARNESS_OCI_MAX_WORKSPACE_BYTES=67108864
# ZHIVEX_HARNESS_OCI_MAX_FILE_WRITE_BYTES=1048576
# ZHIVEX_HARNESS_OCI_TMPFS_MB=256

# Example MCP credential referenced by examples/mcp-config.json.
# DOCS_MCP_API_KEY=
